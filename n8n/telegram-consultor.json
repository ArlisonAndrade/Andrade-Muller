        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify(Object.assign({}, $('Normalizar').first().json.body, $json.imagem_base64 ? { imagem_base64: $json.imagem_base64, imagem_mime: 'image/jpeg' } : {})) }}",
        "options": { "timeout": 120000 }
      },
      "id": "b4bc80e5-3303-4458-a5a7-2022da292185",
      "name": "Chamar o app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [1120, 80]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// O app decide se vale responder. Silencio e uma resposta valida:\n// conversa entre o casal que nao envolve o consultor nao gera mensagem.\nconst r = $input.first().json;\nif (r.responder === false) return [];\nif (!r.texto) return [];\n\n// O no do Telegram envia com parse_mode HTML, entao \"<\", \">\" e \"&\" do texto\n// puro do app precisam virar entidade — senao o Telegram recusa a mensagem\n// inteira com \"can't parse entities\". Em HTML o \"_\" de chat_id e de\n// telegram_membros nao significa nada, que era o que quebrava no Markdown.\nconst texto = String(r.texto)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nreturn [{ json: { ...r, texto } }];"
      },
      "id": "9df22feb-dadf-4af9-873c-2f6ea29b0278",
      "name": "Vale responder?",
