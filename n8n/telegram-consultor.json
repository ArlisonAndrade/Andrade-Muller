    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normaliza os tres tipos de update num formato so: texto, foto e clique\n// no botao desfazer. Retornar [] interrompe o fluxo — e assim que sticker e\n// entrada no grupo sao descartados sem chamar o app.\nconst entrada = $input.first();\nconst u = entrada.json;\n\nif (u.callback_query) {\n  const cb = u.callback_query;\n  return [{\n    json: {\n      rota: 'desfazer',\n      chat_id: cb.message.chat.id,\n      callback_query_id: cb.id,\n      tem_foto: false,\n      body: { token: String(cb.data || '').replace(/^desfazer:/, '') },\n    },\n  }];\n}\n\nconst m = u.message || u.edited_message;\nif (!m) return [];\n\n// Foto de cupom: o texto vem na legenda, e costuma ser ela que diz a\n// categoria (\"mercado\"). Foto sem legenda tambem vale — o modelo le o cupom.\nconst temFoto = Array.isArray(m.photo) && m.photo.length > 0;\nconst texto = m.text || m.caption || '';\nif (!texto && !temFoto) return [];\n\nconst item = {\n  json: {\n    rota: 'mensagem',\n    chat_id: m.chat.id,\n    callback_query_id: '',\n    tem_foto: temFoto,\n    body: {\n      chat_id: m.chat.id,\n      message_id: m.message_id,\n      user_id: m.from.id,\n      nome: [m.from.first_name, m.from.last_name].filter(Boolean).join(' '),\n      texto,\n    },\n  },\n};\n\n// O Code node descarta o binario se ele nao for devolvido de proposito.\nif (temFoto && entrada.binary) item.binary = entrada.binary;\n\nreturn [item];"
      },
      "id": "1d9239ee-05fa-40d5-9c3e-0f466f672395",
      "name": "Normalizar",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [224, 80]
    },
    {
      "parameters": {
