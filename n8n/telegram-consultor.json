    {
      "parameters": {
        "method": "POST",
        "url": "={{ 'https://andrademuller.vercel.app/api/bank/agente/' + $('Normalizar').first().json.rota }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
