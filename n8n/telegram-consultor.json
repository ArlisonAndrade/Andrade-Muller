    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// O app decide se vale responder. Silencio e uma resposta valida.\nconst r = $input.first().json;\nif (r.responder === false) return [];\nif (!r.texto) return [];\n\n// parse_mode HTML: \"<\", \">\" e \"&\" do texto puro viram entidade, senao o\n// Telegram recusa a mensagem inteira com \"can't parse entities\".\nconst texto = String(r.texto)\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\n\nconst escolha = r.escolha_categoria || null;\n\nreturn [{\n  json: {\n    texto,\n    desfazer_token: r.desfazer_token || '',\n    // Achatado porque os botoes do no do Telegram sao estrutura fixa: cada\n    // um le seu proprio campo.\n    precisa_categoria: !!escolha,\n    transacao: escolha ? escolha.transacaoId : '',\n    opcoes: escolha ? escolha.opcoes : [],\n  },\n}];"
      },
