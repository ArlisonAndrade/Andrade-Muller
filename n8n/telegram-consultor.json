    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Normaliza os quatro tipos de update num formato so: texto, foto, clique\n// em \"desfazer\" e clique num botao de categoria.\nconst entrada = $input.first();\nconst u = entrada.json;\n\nif (u.callback_query) {\n  const cb = u.callback_query;\n  const dados = String(cb.data || '');\n  const comum = { chat_id: cb.message.chat.id, callback_query_id: cb.id, tem_foto: false };\n\n  // \"cat:<transacao_id>:<indice>\" — indice, e nao uuid da categoria, porque\n  // callback_data do Telegram tem teto de 64 bytes.\n  if (dados.startsWith('cat:')) {\n    const [, transacao, indice] = dados.split(':');\n    return [{ json: { ...comum, rota: 'categoria', body: { transacao_id: transacao, indice: Number(indice) } } }];\n  }\n\n  return [{ json: { ...comum, rota: 'desfazer', body: { token: dados.replace(/^desfazer:/, '') } } }];\n}\n\nconst m = u.message || u.edited_message;\nif (!m) return [];\n\n// Foto de cupom: o texto vem na legenda, e costuma ser ela que diz a\n// categoria (\"mercado\"). Foto sem legenda tambem vale — o modelo le o cupom.\nconst temFoto = Array.isArray(m.photo) && m.photo.length > 0;\nconst texto = m.text || m.caption || '';\nif (!texto && !temFoto) return [];\n\nconst item = {\n  json: {\n    rota: 'mensagem',\n    chat_id: m.chat.id,\n    callback_query_id: '',\n    tem_foto: temFoto,\n    body: {\n      chat_id: m.chat.id,\n      message_id: m.message_id,\n      user_id: m.from.id,\n      nome: [m.from.first_name, m.from.last_name].filter(Boolean).join(' '),\n      texto,\n    },\n  },\n};\n\n// O Code node descarta o binario se ele nao for devolvido de proposito.\nif (temFoto && entrada.binary) item.binary = entrada.binary;\n\nreturn [item];"
      },
      "id": "1d9239ee-05fa-40d5-9c3e-0f466f672395",
