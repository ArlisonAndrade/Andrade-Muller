      "id": "435067f1-4e90-4545-81a0-283a55f4dfe7",
      "name": "Tem o que dizer?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [672, 192]
    },
    {
      "parameters": {
        "jsCode": "// Mesmo motivo do outro workflow: o no do Telegram envia com parse_mode\n// HTML, entao \"<\", \">\" e \"&\" do texto puro precisam virar entidade.\nconst r = $input.first().json;\nconst texto = String(r.texto || '')\n  .replace(/&/g, '&amp;')\n  .replace(/</g, '&lt;')\n  .replace(/>/g, '&gt;');\nreturn [{ json: { ...r, texto } }];"
      },
      "id": "8bffc99d-9fb5-44e2-a3fe-14fe201ecbc0",
      "name": "Escapar HTML",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [896, 192]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.texto }}",
        "additionalFields": { "appendAttribution": false, "parse_mode": "HTML" }
      },
      "id": "3299a2ab-4233-49b7-b03d-79225e80f4d4",
      "name": "Falar no grupo",
